    "Despertar en pleno sueño profundo causa 'inercia del sueño': desorientación, dolor de cabeza y más fatiga.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waking in the middle of deep sleep causes 'sleep inertia': disorientation, headache and more fatigue."
          }
        }
      }
    },
    "Dormir": {
      "localizations": {
