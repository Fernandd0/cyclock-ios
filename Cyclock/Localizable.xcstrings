    "Estudio de la NASA: mejora el rendimiento un 34% y la alerta mental un 54%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NASA study: improves performance by 34% and alertness by 54%."
          }
        }
      }
    },
    "Estudios de la NASA con pilotos mostraron que 26 min mejora la alerta (+54%) y el rendimiento (+34%) justo antes de entrar en sueño profundo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NASA studies with pilots showed that 26 min improves alertness (+54%) and performance (+34%) right before entering deep sleep."
          }
        }
      }
    },
    "Evita pantallas 1 h antes de dormir, mantén la habitación fresca (~18°C) y corta la cafeína 6 h antes de acostarte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid screens 1 h before bed, keep your room cool (~18°C / 65°F) and cut caffeine 6 h before bedtime."
          }
        }
      }
    },
