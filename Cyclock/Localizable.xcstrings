        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is stored on your iPhone."
          }
        }
      }
    },
    "Tu cerebro recorre 4 fases de sueño cada ~90 minutos. Despertar al final de un ciclo se siente natural y renovado.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your brain goes through 4 sleep stages every ~90 minutes. Waking at the end of a cycle feels natural and refreshing."
